<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Event banner (ImageView with gradient "tech" background in place of a photo asset) -->
        <ImageView
            android:id="@+id/imgEvent"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/bg_event_banner"
            android:contentDescription="Tech Innovation Day 2026 event banner"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="#33FFFFFF" />

        <TextView
            android:id="@+id/txtEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="TECH INNOVATION DAY 2026"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Info card: date / time / venue -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅  "
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/txtEventDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="25 September 2026"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕘  "
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/txtEventTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="9.00 AM – 4.00 PM"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍  "
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/txtEventVenue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Politeknik Kuching Sarawak"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtEventDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Join us for a full day of talks, workshops and demos exploring AI, mobile development and cloud computing. Network with fellow students, industry speakers and showcase your own projects at Politeknik Kuching Sarawak's flagship tech event."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="4dp"
            android:letterSpacing="0.05"
            android:text="REGISTER NOW"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnViewRegistrations"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="VIEW REGISTRATIONS"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
